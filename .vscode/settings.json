{
  "npm.packageManager": "pnpm",
  "css.lint.emptyRules": "ignore",
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "oxc.enable": true,
  "oxc.fmt.experimental": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "files.associations": {
    "**/.vscode/*.json": "jsonc"
  },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[vue]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  // Only the two places that actually run Tailwind. Pointed at the library sources it offered
  // utility completions inside them, and three of those completions were written into components
  // that ship - where nothing resolves them. `classFunctions` is gone with it: a recipe emits
  // `rp-` BEM names, so IntelliSense had nothing to say about one anyway.
  "tailwindCSS.experimental.configFile": {
    "packages/storybook/styles/globals.css": [
      "packages/ropav/src/**/*.stories.ts",
      "packages/storybook/**"
    ],
    "packages/docs/styles/globals.css": ["packages/docs/**"]
  }
}
