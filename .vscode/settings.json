{
  "npm.packageManager": "pnpm",
  "css.lint.emptyRules": "ignore",
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "oxc.enable": true,
  "oxc.fmt.experimental": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "files.associations": {
    "**/.vscode/*.json": "jsonc"
  },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[vue]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "tailwindCSS.classFunctions": ["tv", "clsx", "cn"],
  "tailwindCSS.experimental.configFile": {
    "packages/storybook/styles/globals.css": [
      "packages/ropav/**",
      "packages/storybook/**",
      "packages/styles/**"
    ]
  }
}
