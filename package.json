{
  "name": "ropav-monorepo",
  "version": "0.3.0",
  "private": true,
  "homepage": "https://github.com/daopk/ropav",
  "bugs": {
    "url": "https://github.com/daopk/ropav/issues"
  },
  "license": "Apache-2.0",
  "author": "daopk",
  "repository": {
    "type": "git",
    "url": "https://github.com/daopk/ropav.git"
  },
  "scripts": {
    "dev": "pnpm --filter @ropav/storybook run dev",
    "build": "pnpm -r run build",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "pnpm -r --no-sort run typecheck",
    "test": "pnpm -r --no-sort run test",
    "clean": "pnpm clean:cache && pnpm i",
    "clean:cache": "find . \\( -name '.next' -o -name 'dist' -o -name 'node_modules' -o -name '.source' -o -name '.contentlayer' -o -name '.vitest-attachments' -o -name 'coverage' -o -name 'bundle-sizes.json' -o -name 'bundle-size.json'  -o -name 'tsconfig.tsbuildinfo'  -o -name 'pnpm-lock.yaml' \\) -prune -exec rm -rf '{}' +",
    "upli": "pnpm up --filter \"./**\"  -L -i",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "25.0.3",
    "bumpp": "11.0.1",
    "clean-package": "2.2.0",
    "eslint-plugin-sort-destructure-keys": "2.0.0",
    "eslint-plugin-storybook": "10.2.10",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "parcel": "2.16.4",
    "postcss": "8.5.23",
    "rollup": "4.59.0",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-postcss": "4.0.2",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=10.x"
  },
  "packageManager": "pnpm@10.26.2"
}
