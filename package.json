{
  "name": "ropav-monorepo",
  "version": "0.6.0",
  "private": true,
  "homepage": "https://github.com/daopk/ropav",
  "bugs": {
    "url": "https://github.com/daopk/ropav/issues"
  },
  "license": "Apache-2.0",
  "author": "daopk",
  "repository": {
    "type": "git",
    "url": "https://github.com/daopk/ropav.git"
  },
  "scripts": {
    "dev": "pnpm --filter @ropav/storybook run dev",
    "build": "pnpm -r run build",
    "docs:dev": "pnpm --filter @ropav/docs run dev",
    "docs:build": "pnpm --filter @ropav/docs run build",
    "docs:preview": "pnpm --filter @ropav/docs run preview",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "pnpm -r --no-sort run typecheck",
    "test": "pnpm -r --no-sort run test",
    "release": "bumpp package.json packages/ropav/package.json packages/styles/package.json",
    "upli": "pnpm up --filter \"./**\"  -L -i",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "catalog:",
    "bumpp": "12.3.0",
    "clean-package": "2.2.0",
    "eslint-plugin-sort-destructure-keys": "3.0.0",
    "eslint-plugin-storybook": "10.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "parcel": "2.16.4",
    "postcss": "8.5.28",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=10.x"
  },
  "packageManager": "pnpm@10.26.2"
}
