{
  "name": "heroui",
  "private": true,
  "version": "3.2.4",
  "license": "MIT",
  "author": {
    "name": "HeroUI",
    "email": "support@heroui.com",
    "url": "https://heroui.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heroui-inc/heroui"
  },
  "scripts": {
    "dev": "pnpm --filter @ropav/storybook run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r --no-sort run lint",
    "lint:fix": "pnpm -r --no-sort run lint --fix",
    "format": "prettier --ignore-path .prettierignore --check .",
    "format:fix": "prettier --ignore-path .prettierignore --write .",
    "typecheck": "pnpm -r --no-sort run typecheck",
    "test": "pnpm -r --no-sort run test",
    "clean": "pnpm clean:cache && pnpm i",
    "clean:cache": "find . \\( -name '.next' -o -name 'dist' -o -name 'node_modules' -o -name '.source' -o -name '.contentlayer' -o -name '.vitest-attachments' -o -name 'coverage' -o -name 'bundle-sizes.json' -o -name 'bundle-size.json'  -o -name 'tsconfig.tsbuildinfo'  -o -name 'pnpm-lock.yaml' \\) -prune -exec rm -rf '{}' +",
    "upli": "pnpm up --filter \"./**\"  -L -i",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "25.0.3",
    "@typescript-eslint/eslint-plugin": "8.50.1",
    "@typescript-eslint/parser": "8.50.1",
    "bumpp": "11.0.1",
    "clean-package": "2.2.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-only-warn": "1.1.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-sort-destructure-keys": "2.0.0",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-storybook": "10.2.10",
    "eslint-plugin-unused-imports": "4.3.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "lint-staged": "16.2.7",
    "parcel": "2.16.4",
    "postcss": "8.5.23",
    "prettier": "3.7.4",
    "prettier-plugin-css-order": "2.1.2",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rollup": "4.59.0",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-postcss": "4.0.2",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1"
  },
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=10.x"
  },
  "packageManager": "pnpm@10.26.2"
}
