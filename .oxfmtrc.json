{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "packages/storybook/styles/globals.css",
    "functions": ["tv", "clsx", "cn"]
  },
  "sortImports": {
    "groups": [
      "type",
      "builtin",
      "external",
      "internal",
      "subpath",
      "parent",
      "sibling",
      "index",
      "side_effect",
      "style",
      "unknown"
    ],
    "newlinesBetween": true,
    "ignoreCase": true,
    "order": "asc",
    "internalPattern": ["@/", "~/", "#"]
  },
  "ignorePatterns": [
    "**/dist",
    "**/build",
    "**/storybook-static",
    "**/node_modules",
    "**/coverage",
    "**/__snapshots__",
    "**/.DS_Store",
    "pnpm-lock.yaml",
    "**/*.md",
    "**/*.mdx"
  ]
}
