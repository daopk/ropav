{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `vitest.config.ts` imports `vite.config.ts` by its real filename, which Vite's native
    // config loader requires. This package only ever typechecks, so nothing is emitted that
    // could carry the extension through.
    "allowImportingTsExtensions": true
  },
  "include": [".storybook/**/*", "vitest.config.ts", "vite.config.ts"],
  "exclude": ["node_modules", "storybook-static"]
}
