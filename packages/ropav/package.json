{
  "name": "ropav",
  "version": "0.3.0",
  "description": "\ud83d\ude80 Beautiful and modern Vue UI library built with Vapor Mode and Tailwind CSS 4.0.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "daopk",
  "homepage": "https://github.com/daopk/ropav",
  "keywords": [
    "ropav",
    "vue",
    "vue 3",
    "vapor",
    "vapor mode",
    "components",
    "vue components",
    "vue ui"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./styles": {
      "style": "./src/styles.css",
      "default": "./src/styles.css"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daopk/ropav.git",
    "directory": "packages/ropav"
  },
  "bugs": {
    "url": "https://github.com/daopk/ropav/issues"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "node scripts/build.mjs --tsc",
    "build:fast": "node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:jsdom": "vitest run --project vue-jsdom",
    "test:browser": "vitest run --project vue-browser",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "clean-package && node scripts/update-exports.mjs",
    "postpack": "clean-package restore"
  },
  "clean-package": "./clean-package.config.json",
  "dependencies": {
    "@internationalized/date": "3.12.3",
    "@internationalized/number": "3.6.7",
    "@internationalized/string": "3.2.10",
    "@ropav/styles": "workspace:*",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@ropav/testing": "workspace:*",
    "@storybook/vue3": "10.2.10",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/vue-table": "8.21.3",
    "@types/fs-extra": "11.0.4",
    "@vitejs/plugin-vue": "catalog:",
    "clean-package": "2.2.0",
    "fs-extra": "11.3.3",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "unplugin-icons": "23.0.1",
    "vite": "7.3.5",
    "vitest": "4.1.10",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0",
    "vue": "^3.6.0-rc.5"
  }
}
