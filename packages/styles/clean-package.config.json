{
  "remove": ["devDependencies", "scripts", "clean-package"],
  "replace": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "style": "./dist/index.css",
    "browser": "./dist/ropav.min.css",
    "unpkg": "./dist/ropav.min.css",
    "jsdelivr": "./dist/ropav.min.css",
    "sideEffects": ["*.css"],
    "exports": {
      ".": {
        "style": "./dist/index.css",
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./css": {
        "style": "./dist/index.css",
        "default": "./dist/index.css"
      },
      "./animations.css": {
        "style": "./dist/animations.css",
        "default": "./dist/animations.css"
      },
      "./compat-0.10.css": {
        "style": "./dist/compat-0.10.css",
        "default": "./dist/compat-0.10.css"
      },
      "./motion.css": {
        "style": "./dist/motion.css",
        "default": "./dist/motion.css"
      },
      "./slots.css": {
        "style": "./dist/slots.css",
        "default": "./dist/slots.css"
      },
      "./bundled.css": "./dist/ropav.min.css",
      "./components/*": {
        "types": "./dist/components/*/index.d.ts",
        "import": "./dist/components/*/index.js",
        "default": "./dist/components/*/index.js"
      },
      "./base": "./dist/base/base.css",
      "./base/*.css": "./dist/base/*.css",
      "./components/*.css": "./dist/components/*.css",
      "./themes/*": "./dist/themes/*.css",
      "./themes/*.css": "./dist/themes/*.css",
      "./utilities": "./dist/utilities/index.css",
      "./package.json": "./package.json"
    }
  },
  "backupPath": ".package.json.backup"
}
