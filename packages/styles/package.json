{
  "name": "@ropav/styles",
  "version": "0.3.0",
  "description": "Ropav core styles - framework-agnostic CSS and Tailwind variants",
  "keywords": [
    "css",
    "design system",
    "ropav",
    "tailwind-variants",
    "tailwindcss"
  ],
  "homepage": "https://github.com/daopk/ropav",
  "bugs": {
    "url": "https://github.com/daopk/ropav/issues"
  },
  "license": "Apache-2.0",
  "author": "daopk",
  "repository": {
    "type": "git",
    "url": "https://github.com/daopk/ropav.git",
    "directory": "packages/styles"
  },
  "style": "./index.css",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "style": "./index.css",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./css": {
      "style": "./index.css",
      "default": "./index.css"
    },
    "./components/*": {
      "types": "./src/components/*/index.ts",
      "import": "./src/components/*/index.ts",
      "default": "./src/components/*/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs --tsc",
    "build:fast": "node scripts/build.mjs",
    "dev": "rollup -c rollup.config.mjs --watch",
    "measure-size": "node scripts/measure-bundle-size.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "dependencies": {
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@tailwindcss/cli": "4.3.0",
    "clean-package": "2.2.0",
    "fs-extra": "11.3.3",
    "rollup": "4.59.0",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  },
  "clean-package": "./clean-package.config.json"
}
