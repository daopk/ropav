{
  "name": "@ropav/styles",
  "version": "0.11.1",
  "description": "Ropav core styles - framework-agnostic CSS",
  "keywords": [
    "css",
    "design system",
    "ropav"
  ],
  "homepage": "https://github.com/daopk/ropav",
  "bugs": {
    "url": "https://github.com/daopk/ropav/issues"
  },
  "license": "Apache-2.0",
  "author": "daopk",
  "repository": {
    "type": "git",
    "url": "https://github.com/daopk/ropav.git",
    "directory": "packages/styles"
  },
  "style": "./index.css",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "style": "./index.css",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./css": {
      "style": "./index.css",
      "default": "./index.css"
    },
    "./animations.css": {
      "style": "./animations.css",
      "default": "./animations.css"
    },
    "./compat-0.10.css": {
      "style": "./compat-0.10.css",
      "default": "./compat-0.10.css"
    },
    "./motion.css": {
      "style": "./motion.css",
      "default": "./motion.css"
    },
    "./slots.css": {
      "style": "./slots.css",
      "default": "./slots.css"
    },
    "./components/*": {
      "types": "./src/components/*/index.ts",
      "import": "./src/components/*/index.ts",
      "default": "./src/components/*/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs --tsc",
    "build:fast": "node scripts/build.mjs",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "generate:themes": "tsx scripts/themes/generate.ts",
    "measure-size": "node scripts/measure-bundle-size.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "pnpm run build",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "clean-package": "2.2.0",
    "lightningcss": "catalog:",
    "rolldown": "1.2.8",
    "tsx": "4.23.13",
    "typescript": "catalog:"
  },
  "clean-package": "./clean-package.config.json"
}
